{
  "adapter": "hci0",
  "local_name": "Bitle Relay",
  "nickname": "Bitle Relay",
  "identity_path": "/var/lib/hearthbit-relay/identity.json",
  "trust_store_path": "/var/lib/hearthbit-relay/trusted-peers.json",
  "node_role": "INFRA_RELAY",
  "announce_interval_seconds": 300,
  "central_enabled": true,
  "scan_interval_seconds": 20,
  "max_central_links": 4,
  "max_packet_size": 2048,
  "log_level": "INFO",
  "identity_verification": {
    "unknown_signed_policy": "relay-live"
  },
  "flood": {
    "sender_rate_per_second": 8,
    "sender_burst": 32,
    "emergency_rate_per_second": 2,
    "emergency_burst": 8,
    "bridge_rate_per_second": 20,
    "bridge_burst": 64
  },
  "lan": {
    "enabled": false,
    "listen_host": "0.0.0.0",
    "port": 45893,
    "psk_base64": "",
    "discovery": true,
    "service_name": "HearthBit Relay",
    "max_frame_size": 2048,
    "max_connections": 8,
    "connect_timeout_seconds": 10,
    "idle_timeout_seconds": 90,
    "max_gateway_hops": 8
  },
  "mqtt": {
    "enabled": false,
    "host": "mqtt.example.org",
    "port": 8883,
    "community": "refugio-norte",
    "topic_prefix": "hearthbit",
    "tls_ca_file": "",
    "tls_client_cert_file": "",
    "tls_client_key_file": "",
    "username_env": "HEARTHBIT_MQTT_USERNAME",
    "password_env": "HEARTHBIT_MQTT_PASSWORD",
    "secrets_file": "",
    "keepalive_seconds": 60,
    "connect_timeout_seconds": 15,
    "message_expiry_seconds": 3600,
    "sos_expiry_seconds": 600,
    "max_message_age_seconds": 3600,
    "announce_max_age_seconds": 600,
    "future_skew_seconds": 120,
    "max_bridge_hops": 8,
    "bridge_allowlist": [],
    "inbound_queue_size": 128
  },
  "matrix": {
    "enabled": false,
    "homeserver_url": "https://matrix.example.org",
    "rooms": [
      "!rescate:example.org"
    ],
    "sender_allowlist": [
      "@remote-hearthbit:example.org"
    ],
    "bot_user_id": "@hearthbit:example.org",
    "application_service_mode": false,
    "access_token_env": "HEARTHBIT_MATRIX_ACCESS_TOKEN",
    "access_token_file": "",
    "tls_ca_file": "",
    "sync_timeout_seconds": 30,
    "request_timeout_seconds": 15,
    "message_expiry_seconds": 3600,
    "sos_expiry_seconds": 600,
    "max_message_age_seconds": 3600,
    "announce_max_age_seconds": 600,
    "future_skew_seconds": 120,
    "max_bridge_hops": 8,
    "inbound_queue_size": 128,
    "allow_insecure_localhost_for_tests": false,
    "private_opaque": {
      "enabled": false,
      "peer_ids": []
    }
  },
  "store": {
    "path": "/var/lib/hearthbit-relay/relay.db",
    "max_bytes": 67108864,
    "max_packets": 20000,
    "packet_ttl_seconds": 604800,
    "seen_ttl_seconds": 86400,
    "replay_batch": 256,
    "require_signature": true,
    "message_types": ["0x02", "0x04"]
  }
}
